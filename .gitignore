# ========================================================
# Terraform module .gitignore
# ========================================================
# This is intended for reusable modules, not root modules.
# We ignore files that are:
#   1) Generated by Terraform locally
#   2) Contain sensitive data
#   3) Local overrides for experimentation
# ========================================================

# ------------------------------------------------------------------------
# 1) Terraform local working directories
# ------------------------------------------------------------------------
# .terraform/ stores provider binaries, downloaded modules, and metadata.
# It is always local and should never be committed.
.terraform/

# Nested .terraform folders (in subdirectories) if any
**/.terraform/*

# ------------------------------------------------------------------------
# 2) Terraform lock file
# ------------------------------------------------------------------------
# .terraform.lock.hcl locks provider versions.
# - In root modules, you commit this to ensure consistent builds.
# - In reusable modules, you do NOT commit it to allow flexibility for consumers.
.terraform.lock.hcl

# ------------------------------------------------------------------------
# 3) Terraform state files
# ------------------------------------------------------------------------
# terraform.tfstate contains the actual state of managed resources.
# terraform.tfstate.backup is an automatic backup created by Terraform.
# Both contain resource details and potentially sensitive info like ARNs, IPs, etc.
terraform.tfstate
terraform.tfstate.backup

# Any other .tfstate files (for example, workspace-specific)
*.tfstate
*.tfstate.*

# ------------------------------------------------------------------------
# 4) Crash logs
# ------------------------------------------------------------------------
# Terraform writes crash logs when the process fails unexpectedly.
# These are for local debugging and should never be committed.
crash.log
crash.*.log

# ------------------------------------------------------------------------
# 5) Sensitive variables
# ------------------------------------------------------------------------
# *.tfvars files often contain secrets (passwords, keys) or environment-specific data.
# Never commit them in a module repo.
*.tfvars
*.tfvars.json

# ------------------------------------------------------------------------
# 6) Local override files
# ------------------------------------------------------------------------
# Overrides are meant for experimenting locally.
# They allow modifying resource definitions without touching main files.
# They should not be committed in reusable modules.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include specific overrides if necessary using negation:
# !example_override.tf

# ------------------------------------------------------------------------
# 7) Terraform plan output
# ------------------------------------------------------------------------
# Terraform plan can be saved with -out=tfplan
# These are ephemeral and should never be committed.
*.tfplan*

# ------------------------------------------------------------------------
# 8) Terraform CLI configuration
# ------------------------------------------------------------------------
# These files configure Terraform CLI behavior locally.
# They are machine-specific and must not be committed.
.terraformrc
terraform.rc

# ------------------------------------------------------------------------
# 9) Local scratch notes
# ------------------------------------------------------------------------
# tmp.md files are local scratchpads (e.g. captured account IDs, SSO
# instance IDs, device codes). They hold org/account identifiers we don't
# want on a public repo. Keep them local; never commit.
tmp.md
**/tmp.md
